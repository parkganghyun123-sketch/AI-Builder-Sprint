# 이 파일을 복사해 .env로 만들고 값을 채우세요.
# .env는 절대 커밋하지 않습니다.

# ---------------------------------------------------------------- 모두싸인 (C)
# 설정 → 개인설정 → API KEY 에서 발급 (API 이용 승인 필요)
# ⚠️ API Key는 최초 발급 시에만 전체를 볼 수 있습니다. 즉시 저장하세요.
MODUSIGN_EMAIL=
MODUSIGN_API_KEY=
# 웹훅 URL에 넣을 무작위 토큰 — 생성: openssl rand -hex 16
# 모두싸인은 웹훅 서명(HMAC)을 지원하지 않아 URL 자체를 비밀로 쓴다
WEBHOOK_PATH_TOKEN=

# 스파이크 테스트용
TEST_WORKER_EMAIL=
TEST_OWNER_EMAIL=
TEST_PDF=spikes/sample_contract.pdf

# ---------------------------------------------------------------- Upstage (A)
# Document Parse / Information Extract / Solar 공통
UPSTAGE_API_KEY=

# ---------------------------------------------------------------- OpenAI (챗봇 자유 설명)
# 비어 있으면 기존 Upstage 근거 제한 설명으로 안전하게 폴백합니다.
# Responses API 요청은 store=false이며 비식별 사실 카드와 검증 KB만 전송합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# ---------------------------------------------------------------- 인프라 (C)
# 프론트 배포 도메인 — 쉼표로 여러 개. 비우면 localhost만 허용
CORS_ORIGINS=

# Supabase 접속 문자열. 비워두면 계약 이력을 메모리에 저장한다
# (재시작 시 소실). 설정 여부는 GET /health 의 "store" 로 확인한다.
#
# Supabase 대시보드 → Project Settings → Database → Connection string
#   · URI 탭의 값을 그대로 붙여넣으면 된다 (postgresql://... 형태)
#   · [YOUR-PASSWORD] 를 실제 DB 비밀번호로 바꿀 것
#   · 드라이버(+psycopg)는 코드가 자동으로 붙인다
DATABASE_URL=

# 공공데이터포털 — 사용 여부 미정 (Day 1 확인)
PUBLIC_DATA_API_KEY=
